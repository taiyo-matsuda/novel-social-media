// Cloudflare Workers の設定。秘密情報はここに書かず、ローカルは .dev.vars、本番は `wrangler secret put` で入れる
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 本番の URL は https://tsuzuri-api.<workers.dev のサブドメイン>.workers.dev になる
  "name": "tsuzuri-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "novel-db",
      // 本番の D1（`wrangler d1 create novel-db` で作成）。秘密ではない
      "database_id": "5723bc1a-5c17-4287-a0da-94eb35b62230",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "ANTHROPIC_MODEL": "claude-opus-5-5",
    // Google ログインで認めるクライアントID（Web, iOS）。秘密ではない
    "GOOGLE_CLIENT_IDS": "396718317713-pn89nr0mc059mecl8r3avgusm9j1vsqb.apps.googleusercontent.com,396718317713-48nmgne8mhce12ivqtajit6fco7bksdo.apps.googleusercontent.com",
  },
}
