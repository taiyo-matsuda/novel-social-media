# ローカル開発用。.dev.vars にコピーして使う（.dev.vars はコミットしない）

# ログインの署名に使う秘密の文字列。`openssl rand -base64 32` などで作る
BETTER_AUTH_SECRET=
# このサーバーのURL
BETTER_AUTH_URL=http://localhost:8787
# アプリをブラウザで試すときの開発サーバー（カンマ区切り）
TRUSTED_ORIGINS=http://localhost:8081

# Google ログインのクライアントID は wrangler.jsonc の vars に入っている。手元で変えたいときだけ上書きする
# GOOGLE_CLIENT_IDS=

# Claude API（https://console.anthropic.com/ で発行）。空ならAIはフェイクで動く
ANTHROPIC_API_KEY=

# 通報などを運営に知らせる Slack の Incoming Webhook の URL。空なら知らせない
OPS_WEBHOOK_URL=
# 運営の管理画面（http://localhost:8787/admin）に入るための合言葉。`openssl rand -base64 32` などで作る。空なら管理画面は使えない
ADMIN_TOKEN=
